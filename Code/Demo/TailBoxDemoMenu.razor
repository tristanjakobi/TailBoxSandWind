									<div class="text-sm text-muted">Arbitrary all-corner radius.</div>
								</div>
								<div class="@RadiusDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">rounded-full</div>
									<div class="tb-radius-sample rounded-full bg-accent text-[#0d1418] flex items-center justify-center font-black">full</div>
									<div class="text-sm text-muted">Full all-corner radius.</div>
								</div>
							</div>
						}
						else if ( screen.Title == StackTitle )
						{
							<div class="@BoundsWideClass">
								<div class="flex flex-col gap-1">
									<div class="text-xs uppercase tracking-wider text-accent">z index</div>
									<div class="text-sm leading-relaxed text-muted">The three panels overlap. Higher z values draw in front.</div>
								</div>
								<div class="relative h-[220px] rounded-lg bg-[#101820] border border-white/10 overflow-hidden">
									<div class="absolute top-3 left-3 z-0 w-[284px] h-[112px] rounded-lg bg-danger text-white border border-white/10 flex items-center justify-center font-bold ">z-0</div>
									<div class="absolute top-[40px] left-[52px] z-20 w-[284px] h-[112px] rounded-lg bg-panel-strong text-white border border-accent flex items-center justify-center font-bold ">z-20</div>
									<div class="absolute top-[72px] left-[104px] z-[75] w-[284px] h-[112px] rounded-lg bg-accent text-[#0d1418] border border-white/10 flex items-center justify-center font-black ">z-[75]</div>
								</div>
							</div>
						}
						else if ( screen.Title == OverflowTitle )
						{
							<div class="flex flex-col gap-5">
								<div class="@BoundsWideClass">
									<div class="flex flex-col gap-1">
										<div class="text-xs uppercase tracking-wider text-accent">overflow-hidden</div>
										<div class="text-sm leading-relaxed text-muted">The child is much wider and taller than its parent, so clipping is visible on both axes.</div>
									</div>
									<div class="w-[320px] h-[112px] overflow-hidden rounded-lg bg-[#101820] border border-white/10 p-2">
										<div class="w-[1180px] h-[220px] rounded-md bg-accent text-[#0d1418] flex items-start justify-start p-4 font-black">wide and tall content clipped</div>
									</div>
								</div>

								<div class="flex flex-row flex-wrap gap-5 items-stretch">
									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">overflow-scroll</div>
										<div class="text-sm leading-relaxed text-muted">Both axes can scroll because the child is larger in both directions.</div>
										<div class="w-full h-[112px] overflow-scroll rounded-lg bg-[#101820] border border-white/10 p-2">
											<div class="w-[1180px] h-[220px] rounded-md bg-panel-strong border border-accent flex items-start justify-start p-4 font-bold">scrollable wide and tall content</div>
										</div>
									</div>

									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">overflow-visible</div>
										<div class="text-sm leading-relaxed text-muted">The child is allowed to paint beyond the panel bounds.</div>
										<div class="w-[220px] h-[112px] overflow-visible rounded-lg bg-[#101820] border border-white/10 p-2">
											<div class="w-[320px] h-[160px] rounded-md bg-accent text-[#0d1418] flex items-start justify-start p-4 font-black">visible outside</div>
										</div>
									</div>

									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">overflow-x-hidden</div>
										<div class="text-sm leading-relaxed text-muted">Only horizontal overflow is clipped; the content is intentionally too wide.</div>
										<div class="w-full h-[112px] overflow-x-hidden rounded-lg bg-[#101820] border border-white/10 p-2">
											<div class="w-[1180px] h-[54px] rounded-md bg-good text-[#0d1418] flex items-center justify-start p-4 font-bold">horizontal overflow clipped</div>
										</div>
									</div>

									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">overflow-y-scroll</div>
										<div class="text-sm leading-relaxed text-muted">Only vertical overflow scrolls; the content is intentionally too tall.</div>
										<div class="w-full h-[112px] overflow-y-scroll rounded-lg bg-[#101820] border border-white/10 p-2">
											<div class="w-full h-[220px] rounded-md bg-danger text-white flex items-start justify-start p-4 font-bold">vertical overflow scrolls</div>
										</div>
									</div>
								</div>
							</div>
						}
						else
						{
							<div class="flex flex-row flex-wrap gap-5 items-stretch">
								@foreach ( var tile in screen.Tiles )
								{
									<div class="@TileClass( tile )">
										<div class="@ProbeClass( tile )"></div>
										<div class="uppercase tracking-wider text-muted leading-snug">@tile.Label</div>
										<div class="leading-relaxed text-muted text-sm">@tile.Body</div>
									</div>
								}
							</div>
						}
					</section>
				}
				else
				{
					<section @key="SafeActiveScreen" class="@ScreenClass">
						<div class="@HeroPanelClass">
							<div class="flex flex-col gap-3 flex-1">
								<div class="text-xs uppercase tracking-[0.18em] text-accent">Current support</div>
								<div class="text-2xl leading-tight font-black text-text">What tailw&amp; emits right now.</div>
								<div class="text-sm leading-relaxed text-muted max-w-[720px]">
									This screen is the practical support matrix for the current s&amp;box-safe emitter. Anything outside this surface is parsed and reported instead of being silently generated.
								</div>
							</div>
							<div class="w-[320px] p-4 rounded-xl bg-[#101820] border border-white/10 ">
								<div class="text-xs uppercase tracking-wider text-muted">Generated demo</div>
								<div class="text-2xl font-black text-accent mt-1">0 skipped</div>
								<div class="text-sm text-muted mt-2">The visual screens only use utilities that are meant to render in runtime Razor UI.</div>
							</div>
						</div>

						<div class="rounded-xl bg-panel border border-border overflow-hidden flex flex-col">
							<div class="flex flex-row bg-[#101820] border-b border-border p-3 text-xs uppercase tracking-wider text-accent">
								<div class="w-[220px] shrink-0">Area</div>
								<div class="w-[160px] shrink-0">Status</div>
								<div class="flex-1">What works</div>
							</div>
							@foreach ( var row in SupportRows )
							{
								<div class="flex flex-row items-start gap-4 border-b border-white/10 p-3">
									<div class="w-[220px] shrink-0 text-sm font-bold text-text">@row.Area</div>
									<div class="w-[160px] shrink-0">
										<div class="@SupportBadgeClass( row.Status )">@row.Status</div>
									</div>
									<div class="flex-1 text-sm leading-relaxed text-muted">@row.Notes</div>
								</div>
							}
						</div>
					</section>
				}
			</div>
		</main>
	</div>
</root>


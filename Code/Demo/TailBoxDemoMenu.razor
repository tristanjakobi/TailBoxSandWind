-wider tracking-[0.18em] underline line-through no-underline decoration-accent decoration-2 underline-offset-4 -underline-offset-2 truncate whitespace-nowrap whitespace-pre whitespace-pre-line break-all overflow-hidden overflow-scroll overflow-y-scroll overflow-x-hidden pointer-events-all pointer-events-auto cursor-none cursor-pointer cursor-progress cursor-wait cursor-crosshair cursor-text cursor-move cursor-not-allowed cursor-[crosshair] z-0 z-10 z-20 z-50 blur-sm blur-md brightness-50 brightness-125 contrast-125 grayscale invert hue-rotate-15 saturate-150 sepia opacity-75 opacity-[0.35] shadow shadow-lg shadow-none shadow-[0_0_12px_black] text-shadow text-shadow-lg text-shadow-[0_0_12px_black] backdrop-blur-lg backdrop-brightness-125 backdrop-contrast-125 backdrop-grayscale backdrop-hue-rotate-15 backdrop-invert backdrop-saturate-150 backdrop-sepia mix-blend-normal mix-blend-multiply transform-none transform-[translateX(4px)_scale(1.1)] origin-top-left origin-bottom-right transition transition-all transition-colors transition-opacity transition-shadow transition-transform duration-150 delay-75 ease-in-out animate-none animate-[fade_1s_ease] hover:bg-accent active:bg-accent focus:border-accent intro:opacity-0 outro:opacity-0 [background-color:#101820] [box-shadow:0_0_12px_black] [text-shadow:0_0_12px_black] [backdrop-filter:blur(10px)] [mask-scope:default] [mask-scope:filter] [perspective-origin:50%_50%] [perspective-origin-x:50%] [perspective-origin-y:50%] [transform-origin-x:50%] [transform-origin-y:50%] [border-top-left-radius:18px] [border-top-right-radius:18px] [border-bottom-left-radius:18px] [border-bottom-right-radius:18px] [animation-delay:0.1s] [animation-direction:alternate] [animation-duration:1s] [animation-fill-mode:both] [animation-iteration-count:infinite] [animation-name:fade] [animation-play-state:running] [animation-timing-function:ease-out] *@

<root class="absolute inset-0 pointer-events-all bg-[#0d1418] text-text font-sans">
	<div class="absolute inset-0 flex flex-row overflow-hidden">
		<aside class="tb-demo-sidebar h-full shrink-0 bg-bg border-r border-border p-4 flex flex-col gap-4">
			<div class="flex flex-col gap-2 p-2">
				<img class="tailwand-logo" src="/Libraries/TailBoxSandWind/Code/TailBox/untitled.png" />
				<div class="text-xs uppercase tracking-[0.18em] text-muted">tailw&amp;</div>
				<div class="text-2xl leading-tight font-black text-text">Feature Demo</div>
				<div class="text-sm leading-normal text-muted">Pure C# Tailwind-shaped utilities emitted as s&amp;box-safe SCSS.</div>
			</div>

			<nav class="flex flex-col gap-2 overflow-y-scroll flex-1">
				@for ( var i = 0; i < ScreenCount; i++ )
				{
					var index = i;
					<button class="@NavClass( index )" onclick="@(() => SelectScreen( index ))">
						<div class="tb-demo-nav-index shrink-0 text-xs leading-normal uppercase tracking-wider whitespace-normal">Screen @(index + 1)</div>
						<div class="flex-1 text-sm leading-normal font-bold whitespace-normal">@GetScreenTitle( index )</div>
					</button>
				}
			</nav>

			<div class="p-3 rounded-lg border border-white/10 bg-white/5 text-xs leading-relaxed text-muted">
				<div class="font-bold text-accent uppercase tracking-wider mb-2">Scene bootstrap</div>
				<div>Add the tailw&amp; Demo component to any GameObject. It keeps a ScreenPanel, camera, mouse UI, and this menu alive.</div>
			</div>
		</aside>

		<main class="flex-1 h-full overflow-hidden bg-bg-soft">
			<div @key="SafeActiveScreen" class="w-full h-full overflow-y-scroll p-6 flex flex-col gap-6">
				<header class="flex flex-row flex-wrap items-center justify-between gap-4 border-b border-border pb-4">
					<div class="flex flex-col gap-1">
						<div class="text-xs uppercase tracking-[0.18em] text-accent">Screen @(SafeActiveScreen + 1) of @ScreenCount</div>
						<div class="text-[34px] leading-[42px] font-black text-text ">@GetScreenTitle( SafeActiveScreen )</div>
					</div>
					<div class="flex flex-row items-center gap-2">
						<button class="@StepperClass" onclick="@Previous">Previous</button>
						<button class="@StepperClass" onclick="@Next">Next</button>
					</div>
				</header>

				@if ( SafeActiveScreen > 0 )
				{
					var screen = FeatureScreens[SafeActiveScreen - 1];
					<section @key="SafeActiveScreen" class="@ScreenClass">
						<div class="@PanelTitleClass">
							<div class="flex flex-col gap-1">
								<div class="text-xs uppercase tracking-wider text-accent">@screen.Eyebrow</div>
								<div class="text-2xl font-black">@screen.Title</div>
							</div>
							<div class="text-sm text-muted">@screen.Note</div>
						</div>

						@if ( screen.Title == SizingTitle )
						{
							<div class="flex flex-col gap-5">
								<div class="@BoundsWideClass">
									<div class="flex flex-col gap-1">
										<div class="text-xs uppercase tracking-wider text-accent">Width ladder</div>
										<div class="text-sm leading-relaxed text-muted">All bars share the same parent, so fractions are directly comparable.</div>
									</div>
									<div class="w-full p-4 rounded-md bg-[#101820] border border-white/10 flex flex-col items-start gap-3">
										<div class="w-full h-[54px] rounded bg-accent text-[#0d1418] flex items-center justify-center font-black">w-full</div>
										<div class="w-2/3 h-[54px] rounded bg-panel-strong text-white flex items-center justify-center font-bold">w-2/3</div>
										<div class="w-1/2 h-[54px] rounded bg-good text-[#0d1418] flex items-center justify-center font-bold">w-1/2</div>
										<div class="w-1/4 h-[54px] rounded bg-danger text-white flex items-center justify-center font-bold">w-1/4</div>
									</div>
								</div>

								<div class="flex flex-row flex-wrap gap-5 items-stretch">
									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">Fixed widths</div>
										<div class="text-sm leading-relaxed text-muted">Arbitrary and token widths sit beside each other instead of filling their cards.</div>
										<div class="p-4 rounded-md bg-[#101820] border border-white/10 flex flex-col gap-3 overflow-hidden">
											<div class="w-[284px] max-w-full h-[54px] rounded bg-accent text-[#0d1418] flex items-center justify-center font-bold">w-[284px]</div>
											<div class="w-[112px] h-[54px] rounded bg-white/10 flex items-center justify-center font-bold">w-[112px]</div>
											<div class="w-screen max-w-full h-[54px] rounded bg-panel-strong text-muted flex items-center justify-center">w-screen capped</div>
										</div>
									</div>

									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">Height ladder</div>
										<div class="text-sm leading-relaxed text-muted">Same width, different heights.</div>
										<div class="p-4 rounded-md bg-[#101820] border border-white/10 flex flex-row gap-3 items-end">
											<div class="w-1/4 h-[54px] rounded bg-white/10 flex items-center justify-center text-xs font-bold">54</div>
											<div class="w-1/4 h-[112px] rounded bg-panel-strong flex items-center justify-center text-xs font-bold">112</div>
											<div class="w-1/4 h-[160px] rounded bg-accent text-[#0d1418] flex items-center justify-center text-xs font-black">160</div>
										</div>
									</div>

									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">Size tokens</div>
										<div class="text-sm leading-relaxed text-muted">The size utility sets width and height together.</div>
										<div class="p-4 rounded-md bg-[#101820] border border-white/10 flex flex-row gap-4 items-end">
											<div class="size-4 rounded bg-white/10"></div>
											<div class="size-6 rounded bg-good"></div>
											<div class="size-8 rounded bg-panel-strong"></div>
											<div class="size-10 rounded bg-accent"></div>
										</div>
									</div>
								</div>
							</div>
						}
						else if ( screen.Title == BoundsTitle )
						{
							<div class="flex flex-col gap-5">
								<div class="@BoundsWideClass">
									<div class="flex flex-col gap-1">
										<div class="text-xs uppercase tracking-wider text-accent">max-w-[420px]</div>
										<div class="text-sm leading-relaxed text-muted">The inner bar asks for 1180px, then max-width caps it.</div>
									</div>
									<div class="w-full p-3 rounded-md bg-[#101820] border border-white/10 overflow-hidden">
										<div class="w-[1180px] max-w-[420px] h-[54px] rounded bg-accent flex items-center justify-center text-[#0d1418] font-bold">capped at max width</div>
									</div>
								</div>

								<div class="flex flex-row flex-wrap gap-5 items-stretch">
									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">w-0</div>
										<div class="text-sm leading-relaxed text-muted">The danger probe has width zero; the accent bar is the reference width.</div>
										<div class="flex flex-row items-center gap-3 p-3 rounded-md bg-[#101820] border border-white/10 overflow-hidden">
											<div class="w-0 h-[54px] bg-danger border border-danger"></div>
											<div class="w-[284px] h-[54px] rounded bg-accent flex items-center justify-center text-[#0d1418] font-bold">reference</div>
										</div>
									</div>

									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">max-h-full</div>
										<div class="text-sm leading-relaxed text-muted">The inner panel is capped to its parent height.</div>
										<div class="h-[150px] p-3 rounded-md bg-[#101820] border border-white/10 overflow-hidden">
											<div class="h-screen max-h-full rounded bg-accent text-[#0d1418] flex items-center justify-center font-bold">height capped</div>
										</div>
									</div>
								</div>
							</div>
						}
						else if ( screen.Title == GapTitle )
						{
							<div class="flex flex-col gap-5">
								<div class="@BoundsWideClass">
									<div class="flex flex-col gap-1">
										<div class="text-xs uppercase tracking-wider text-accent">gap-4</div>
										<div class="text-sm leading-relaxed text-muted">Uniform shorthand gap on both axes. The constrained row wraps into a visible two-by-two block.</div>
									</div>
									<div class="w-[112px] flex flex-row flex-wrap gap-4 p-3 rounded-md bg-[#101820] border border-white/10">
										<div class="size-10 rounded bg-accent"></div>
										<div class="size-10 rounded bg-accent"></div>
										<div class="size-10 rounded bg-accent"></div>
										<div class="size-10 rounded bg-accent"></div>
									</div>
								</div>

								<div class="flex flex-row flex-wrap gap-5 items-stretch">
									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">gap-x-3</div>
										<div class="text-sm leading-relaxed text-muted">Horizontal spacing only. The boxes stay on one row.</div>
										<div class="flex flex-row gap-x-3 p-3 rounded-md bg-[#101820] border border-white/10">
											<div class="size-10 rounded bg-accent"></div>
											<div class="size-10 rounded bg-accent"></div>
											<div class="size-10 rounded bg-accent"></div>
										</div>
									</div>

									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">gap-y-2</div>
										<div class="text-sm leading-relaxed text-muted">Vertical spacing only. The boxes are in a column.</div>
										<div class="flex flex-col gap-y-2 p-3 rounded-md bg-[#101820] border border-white/10">
											<div class="size-10 rounded bg-accent"></div>
											<div class="size-10 rounded bg-accent"></div>
											<div class="size-10 rounded bg-accent"></div>
										</div>
									</div>

									<div class="@BoundsCardClass">
										<div class="text-xs uppercase tracking-wider text-accent">gap-x-3 + gap-y-2</div>
										<div class="text-sm leading-relaxed text-muted">Combined axes use a generated compound rule. The constrained block wraps into rows so both axes are visible.</div>
										<div class="w-[112px] flex flex-row flex-wrap gap-x-3 gap-y-2 p-3 rounded-md bg-[#101820] border border-white/10">
											<div class="size-10 rounded bg-accent"></div>
											<div class="size-10 rounded bg-accent"></div>
											<div class="size-10 rounded bg-accent"></div>
											<div class="size-10 rounded bg-accent"></div>
											<div class="size-10 rounded bg-accent"></div>
											<div class="size-10 rounded bg-accent"></div>
										</div>
									</div>
								</div>
							</div>
						}
						else if ( screen.Title == TextColorsTitle )
						{
							<div class="flex flex-col gap-5">
								<div class="@BoundsWideClass">
									<div class="flex flex-col gap-1">
										<div class="text-xs uppercase tracking-wider text-accent">Text color tokens</div>
										<div class="text-sm leading-relaxed text-muted">Only text color utilities are applied here. Backgrounds come from the neutral demo surface.</div>
									</div>
									<div class="flex flex-row flex-wrap gap-4">
										<div class="tb-demo-tile basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg border border-white/10 flex flex-col gap-2 justify-center">
											<div class="text-xs uppercase tracking-wider text-muted">text-accent</div>
											<div class="text-2xl font-black text-accent">Accent text</div>
										</div>
										<div class="tb-demo-tile basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg border border-white/10 flex flex-col gap-2 justify-center">
											<div class="text-xs uppercase tracking-wider text-muted">text-muted</div>
											<div class="text-2xl font-black text-muted">Muted text</div>
										</div>
										<div class="tb-demo-tile basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg border border-white/10 flex flex-col gap-2 justify-center">
											<div class="text-xs uppercase tracking-wider text-muted">text-danger</div>
											<div class="text-2xl font-black text-danger">Danger text</div>
										</div>
										<div class="tb-demo-tile basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg border border-white/10 flex flex-col gap-2 justify-center">
											<div class="text-xs uppercase tracking-wider text-muted">text-good</div>
											<div class="text-2xl font-black text-good">Good text</div>
										</div>
										<div class="tb-demo-tile basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg border border-white/10 flex flex-col gap-2 justify-center">
											<div class="text-xs uppercase tracking-wider text-muted">text-white</div>
											<div class="text-2xl font-black text-white">White text</div>
										</div>
										<div class="tb-demo-light-surface basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg border border-white/10 flex flex-col gap-2 justify-center">
											<div class="tb-demo-dark-label text-xs uppercase tracking-wider">text-[#0d1418]</div>
											<div class="text-2xl font-black text-[#0d1418]">Arbitrary dark text</div>
										</div>
									</div>
								</div>
							</div>
						}
						else if ( screen.Title == BackgroundColorsTitle )
						{
							<div class="flex flex-col gap-5">
								<div class="@BoundsWideClass">
									<div class="flex flex-col gap-1">
										<div class="text-xs uppercase tracking-wider text-accent">Background color utilities</div>
										<div class="text-sm leading-relaxed text-muted">Color utilities are isolated here; image, repeat, position, and size utilities have their own background image page.</div>
									</div>
									<div class="flex flex-row flex-wrap gap-4">
										<div class="basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg bg-[#101820] border border-white/10 flex flex-col gap-2 justify-center">
											<div class="tb-demo-label-accent text-xs uppercase tracking-wider">bg-[#101820]</div>
											<div class="tb-demo-label-light text-xl font-black">Arbitrary color</div>
										</div>
										<div class="basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg bg-[color:#1b2730] border border-white/10 flex flex-col gap-2 justify-center">
											<div class="tb-demo-label-accent text-xs uppercase tracking-wider">bg-[color:#1b2730]</div>
											<div class="tb-demo-label-light text-xl font-black">Typed arbitrary color</div>
										</div>
										<div class="basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg bg-accent border border-white/10 flex flex-col gap-2 justify-center">
											<div class="tb-demo-dark-label text-xs uppercase tracking-wider">bg-accent</div>
											<div class="tb-demo-dark-label text-xl font-black">Theme color</div>
										</div>
										<div class="basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg bg-good border border-white/10 flex flex-col gap-2 justify-center">
											<div class="tb-demo-dark-label text-xs uppercase tracking-wider">bg-good</div>
											<div class="tb-demo-dark-label text-xl font-black">Success color</div>
										</div>
										<div class="basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg bg-danger border border-white/10 flex flex-col gap-2 justify-center">
											<div class="tb-demo-label-light text-xs uppercase tracking-wider">bg-danger</div>
											<div class="tb-demo-label-light text-xl font-black">Danger color</div>
										</div>
										<div class="basis-1/3 flex-1 w-[220px] h-[124px] p-5 rounded-lg bg-accent/50 border border-white/10 flex flex-col gap-2 justify-center">
											<div class="tb-demo-label-light text-xs uppercase tracking-wider">bg-accent/50</div>
											<div class="tb-demo-label-light text-xl font-black">Background opacity</div>
										</div>
									</div>
								</div>
							</div>
						}
						else if ( screen.Title == BorderWidthsTitle )
						{
							<div class="flex flex-row flex-wrap gap-5 items-stretch">
								<div class="@BorderDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">border</div>
									<div class="h-[112px] rounded-lg border border-accent bg-[#101820] flex items-center justify-center text-white">full border</div>
								</div>
								<div class="@BorderDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">border-2</div>
									<div class="h-[112px] rounded-lg border-2 border-accent bg-[#101820] flex items-center justify-center text-white">two pixel border</div>
								</div>
								<div class="@BorderDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">border-t-[8px]</div>
									<div class="h-[112px] rounded-lg border-t-[8px] border-t-accent bg-[#101820] flex items-center justify-center text-white">top edge only</div>
								</div>
								<div class="@BorderDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">border-b-[8px]</div>
									<div class="h-[112px] rounded-lg border-b-[8px] border-b-accent bg-[#101820] flex items-center justify-center text-white">bottom edge only</div>
								</div>
								<div class="@BorderDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">border-l-[8px]</div>
									<div class="h-[112px] rounded-lg border-l-[8px] border-l-accent bg-[#101820] flex items-center justify-center text-white">left edge only</div>
								</div>
								<div class="@BorderDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">border-r-[8px]</div>
									<div class="h-[112px] rounded-lg border-r-[8px] border-r-accent bg-[#101820] flex items-center justify-center text-white">right edge only</div>
								</div>
							</div>
						}
						else if ( screen.Title == RadiusTitle )
						{
							<div class="flex flex-row flex-wrap gap-5 items-stretch">
								<div class="@RadiusDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">rounded-none</div>
									<div class="tb-radius-sample rounded-none bg-accent text-[#0d1418] flex items-center justify-center font-black">none</div>
									<div class="text-sm text-muted">Square baseline.</div>
								</div>
								<div class="@RadiusDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">rounded-sm</div>
									<div class="tb-radius-sample rounded-sm bg-accent text-[#0d1418] flex items-center justify-center font-black">sm</div>
									<div class="text-sm text-muted">Small all-corner radius.</div>
								</div>
								<div class="@RadiusDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">rounded-md</div>
									<div class="tb-radius-sample rounded-md bg-accent text-[#0d1418] flex items-center justify-center font-black">md</div>
									<div class="text-sm text-muted">Medium all-corner radius.</div>
								</div>
								<div class="@RadiusDemoCardClass">

	private int ActiveScreen { get; set; }

	private int SafeActiveScreen
	{
		get
		{
			if ( ActiveScreen < 0 )
				return 0;

			if ( ActiveScreen >= ScreenCount )
				return ScreenCount - 1;

			return ActiveScreen;
		}
	}

	private string NavClass( int index )
	{
		if ( index == SafeActiveScreen )
			return "tb-demo-nav-button w-full p-4 rounded-lg bg-accent text-[#0d1418] pointer-events-all cursor-pointer text-left border border-accent flex flex-row items-center gap-3";

		return "tb-demo-nav-button w-full p-4 rounded-lg bg-white/5 text-muted pointer-events-all cursor-pointer text-left border border-white/10 flex flex-row items-center gap-3";
	}

	private static string GetScreenTitle( int index )
	{
		if ( index <= 0 )
			return "Overview";

		if ( index > FeatureScreens.Length )
			return FeatureScreens[FeatureScreens.Length - 1].Title;

		return FeatureScreens[index - 1].Title;
	}

	private static string TileClass( DemoTile tile )
	{
		if ( string.IsNullOrWhiteSpace( tile.Classes ) )
			return TileBaseClass;

		return TileBaseClass + " " + tile.Classes;
	}

	private static string ProbeClass( DemoTile tile )
	{
		if ( string.IsNullOrWhiteSpace( tile.ProbeClasses ) )
			return "hidden";

		var baseClass = tile.UseDefaultProbeSize
			? "size-6 rounded bg-accent "
			: "rounded bg-accent ";

		return baseClass + tile.ProbeClasses;
	}

	private static string SupportBadgeClass( string status )
	{
		return status switch
		{
			"Supported" => "px-3 py-1 rounded-md bg-good text-[#0d1418] text-xs font-bold uppercase tracking-wider text-center",
			"Limited" => "px-3 py-1 rounded-md bg-accent text-[#0d1418] text-xs font-bold uppercase tracking-wider text-center",
			_ => "px-3 py-1 rounded-md bg-danger text-white text-xs font-bold uppercase tracking-wider text-center"
		};
	}

	private void SelectScreen( int index )
	{
		ActiveScreen = index;
		StateHasChanged();
	}

	private void Previous()
	{
		ActiveScreen = SafeActiveScreen == 0 ? ScreenCount - 1 : SafeActiveScreen - 1;
		StateHasChanged();
	}

	private void Next()
	{
		ActiveScreen = SafeActiveScreen == ScreenCount - 1 ? 0 : SafeActiveScreen + 1;
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		return HashCode.Combine( ActiveScreen, EnableMouseUi, CaptureMouse );
	}

	private readonly record struct SupportRow( string Area, string Status, string Notes );
	private readonly record struct DemoScreen( string Title, string Eyebrow, string Note, DemoTile[] Tiles );
	private readonly record struct DemoTile( string Label, string Classes, string Body, string ProbeClasses = "", bool UseDefaultProbeSize = true );

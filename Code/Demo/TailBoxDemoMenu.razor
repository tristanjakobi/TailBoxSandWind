									<div class="text-sm text-muted">Large all-corner radius.</div>
								</div>
								<div class="@RadiusDemoCardClass">
									<div class="text-xs uppercase tracking-wider text-accent">rounded-xl</div>
									<div class="tb-radius-sample rounded-xl bg-accent text-[#0d1418] flex items-center justify-center font-black">xl</div>
									<div class="text-sm text-muted">Extra large all-corner radius.</div>
